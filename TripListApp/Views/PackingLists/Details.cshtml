@model TripListApp.Models.PackingList

@{
    ViewData["Title"] = "Packing List Details";
}

<h1>@Model.ListName</h1>

<p class="text-muted">Packing list details and items</p>

<p>
    <strong>Budget:</strong> $@Model.TripBudget <br />
    <strong>Year:</strong> @Model.TripYear
</p>

<div class="mb-3">
    <a asp-controller="Items"
       asp-action="Create"
       asp-route-packingListId="@Model.PackingListId"
       class="btn btn-success">
        Add Item
    </a>

    <a asp-action="Edit"
       asp-route-id="@Model?.PackingListId"
       class="btn btn-primary">
        Edit List
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Lists
    </a>
</div>

@if (Model.Items.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Item</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>

                    <td>
                        @if (item.PackedStatus)
                        {
                            <span class="badge bg-success">Packed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Not Packed</span>
                        }
                    </td>

                    <td>
                        <a asp-controller="Items"
                           asp-action="Details"
                           asp-route-id="@item.ItemId"
                           class="btn btn-sm btn-info">
                            Details
                        </a>

                        <a asp-controller="Items"
                           asp-action="Edit"
                           asp-route-id="@item.ItemId"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>

                        <a asp-controller="Items"
                           asp-action="Delete"
                           asp-route-id="@item.ItemId"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No items have been added to this packing list yet.
    </div>
}