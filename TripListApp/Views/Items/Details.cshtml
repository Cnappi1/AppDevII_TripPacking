@model TripListApp.Models.Item

@{
    ViewData["Title"] = "Item Details";
}

<h1>Item Details</h1>

<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>

        @if (Model.PackedStatus)
        {
            <span class="badge bg-success">Packed</span>
        }
        else
        {
            <span class="badge bg-warning text-dark">Not Packed</span>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.ItemId" class="btn btn-primary">Edit Item</a>

    <a asp-controller="PackingLists"
       asp-action="Details"
       asp-route-id="@Model.PackingListId"
       class="btn btn-secondary">
        Back to Packing List
    </a>
</div>